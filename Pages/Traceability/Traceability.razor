@page "/"
@implements IDisposable

@using HT_Web.Services.State
@using HT_Web.Models.Traceability
@using HT_Web.Services.Traceability
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@inject ITraceabilityService TraceabilityService
@inject ApplicationState AppState
@inject ISnackbar Snackbar

<PageTitle>Harness Traceability</PageTitle>

<!-- Interactive Loading Overlay -->
<MudOverlay Visible="@IsLoading" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudPaper Elevation="4" Class="pa-6 rounded-lg d-flex flex-column align-center text-center" Style="min-width: 340px; max-width: 440px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h6" Class="font-weight-bold">
            @_loadingTitle
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @_loadingSubtitle
        </MudText>
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-4 rounded" Style="width: 100%;" />
    </MudPaper>
</MudOverlay>

<MudStack Spacing="4">
    @if (AppState.CurrentUser is not null && AvailableSites.Count == 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Elevation="1" Class="rounded-lg">
            <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        Access Denied: No Authorized Sites
                    </MudText>
                    <MudText Typo="Typo.body2">
                        User <strong>@AppState.CurrentUser.DisplayName</strong> does not exist or does not have access to any site.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Rounded.Email"
                           Href="mailto:SEWS-ECentralElectricalTestEngineers@sgcci.onmicrosoft.com?subject=Harness%20Traceability%20Software">
                    Contact Support
                </MudButton>
            </div>
        </MudAlert>
    }

    <!-- 1. SEARCH & SCAN CARD -->
    <MudCard Elevation="2" Class="rounded-lg">
        <MudCardHeader Class="pb-1">
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                    <MudIcon Icon="@Icons.Material.Rounded.QrCodeScanner" />
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Harness Scan & Search</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Operator: @(AppState.CurrentUser?.DisplayName ?? "User")
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="pt-2">
            <MudGrid AlignItems="Center">
                <!-- Site Selector Dropdown (Placed right next to serial number) -->
                <MudItem xs="12" sm="4" md="3">
                    <MudSelect T="string"
                               @bind-Value="SelectedSite"
                               Label="Site"
                               Variant="Variant.Outlined"
                               Margin="Margin.Normal"
                               AnchorOrigin="Origin.BottomCenter"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Rounded.LocationOn"
                               AdornmentColor="Color.Primary"
                               Disabled="@(AvailableSites.Count == 0)">
                        @foreach (var site in AvailableSites)
                        {
                            <MudSelectItem T="string" Value="@site">@site</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Serial Number Barcode Input -->
                <MudItem xs="12" sm="8" md="5">
                    <MudTextField T="string"
                                  @bind-Value="SearchValue"
                                  @ref="_searchInput"
                                  Label="@(IsFinalLabel ? "Harness Final Label" : "Travel Ticket")"
                                  Placeholder="@(IsFinalLabel ? "Scan or enter Harness Label..." : "Scan or enter Travel Ticket...")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Normal"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.QrCodeScanner"
                                  AdornmentColor="Color.Primary"
                                  Immediate="true"
                                  OnKeyDown="HandleKeyDown"
                                  Class="font-weight-bold text-uppercase" />
                </MudItem>

                <!-- Filter Controls -->
                <MudItem xs="12" md="4" Class="d-flex flex-column gap-1">
                    <MudRadioGroup T="bool" @bind-Value="IsFinalLabel" Class="d-flex align-center">
                        <MudRadio T="bool" Value="@true" Color="Color.Primary" Dense="true">Final Label</MudRadio>
                        <MudRadio T="bool" Value="@false" Color="Color.Secondary" Dense="true">Travel Ticket</MudRadio>
                    </MudRadioGroup>
                    <MudCheckBox T="bool"
                                 @bind-Value="IncludeAllErrors"
                                 Label="Electrical Test Process Only"
                                 Color="Color.Primary"
                                 Dense="true"
                                 Size="Size.Small" />
                </MudItem>
            </MudGrid>
        </MudCardContent>

        <MudCardActions Class="px-4 pb-4 pt-0 d-flex justify-space-between align-center">
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.Search"
                           OnClick="Search"
                           Disabled="@(string.IsNullOrWhiteSpace(SearchValue) || IsLoading || (AppState.CurrentUser is not null && AvailableSites.Count == 0))">
                    Search
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Rounded.Clear"
                           OnClick="ClearSearch"
                           Disabled="@(string.IsNullOrWhiteSpace(SearchValue) && ProcessHistory.Count == 0)">
                    Clear
                </MudButton>
            </div>

            @if (_hasSearched && ProcessHistory.Count > 0)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Rounded.PictureAsPdf"
                           OnClick="ExportPdf">
                    Export PDF
                </MudButton>
            }
        </MudCardActions>
    </MudCard>

    <!-- 2. RESULTS SECTION (Only rendered once loading finishes and data is collected) -->
    @if (!IsLoading && _hasSearched)
    {
        <!-- Verdict Banner -->
        <MudAlert Severity="@(Errors.Count == 0 ? Severity.Success : Severity.Error)"
                  Variant="Variant.Filled"
                  Elevation="1"
                  Class="rounded-lg py-2">
            <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@(Errors.Count == 0 ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Warning)" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                            @(Errors.Count == 0 ? "STATUS: CONFORMANT (PASS)" : $"STATUS: DEFECTS DETECTED ({Errors.Count} ERROR(S))")
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @(Errors.Count == 0 ? "No active defects recorded for this harness." : "Review rework history and error details below.")
                        </MudText>
                    </div>
                </div>
                @if (_harnessInfo is not null)
                {
                    <div class="d-flex flex-wrap gap-3">
                        <MudText Typo="Typo.caption" Class="text-white">
                            <strong>Customer:</strong> @_harnessInfo.Customer |
                            <strong>Project:</strong> @_harnessInfo.Project |
                            <strong>Family:</strong> @_harnessInfo.Family |
                            <strong>Line:</strong> @_harnessInfo.Line
                        </MudText>
                    </div>
                }
            </div>
        </MudAlert>

        <!-- Dynamic Error Cards Strip -->
        <div class="mt-1">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2 text-muted">
                Inspection Summary & Defects by Type
            </MudText>
            <MudGrid Spacing="3">
                <!-- Total Process Steps Card -->
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="1" Class="pa-3 rounded-lg border-l-4" Style="border-left-color: var(--mud-palette-primary) !important;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Process Steps</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">@ProcessHistory.Count</MudText>
                    </MudPaper>
                </MudItem>

                <!-- Total Errors Card -->
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="1" Class="pa-3 rounded-lg border-l-4"
                              Style="@($"border-left-color: {(Errors.Count > 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)")} !important;")">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Errors</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)">
                            @Errors.Count
                        </MudText>
                    </MudPaper>
                </MudItem>

                <!-- Dynamic Individual Card for EACH distinct error type detected -->
                @if (Errors.Count > 0)
                {
                    @foreach (var group in Errors.GroupBy(e => e.ErrorType).OrderBy(g => g.Key))
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudPaper Elevation="1" Class="pa-3 rounded-lg border-l-4"
                                      Style="@($"border-left-color: {GetErrorHexColor(group.Key)} !important;")">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GetErrorLabel(group.Key)</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetErrorColor(group.Key)" Variant="Variant.Outlined">
                                        Type @group.Key
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.h5" Class="font-weight-bold mt-1" Color="@GetErrorColor(group.Key)">
                                    @group.Count()
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    }
                }
            </MudGrid>
        </div>

        <!-- 3. EXPANDABLE TABLES (STACKED ONE ON TOP OF THE OTHER) -->
        <MudExpansionPanels MultiExpansion="true" Elevation="1" Class="rounded-lg mt-2">
            <!-- PANEL 1: PROCESS HISTORY -->
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.History" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Process History</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@ProcessHistory.Count</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (ProcessHistory.Count == 0)
                    {
                        <div class="pa-6 text-center text-muted">
                            <MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body2">No process history found for this reference.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0" Style="overflow-x: auto;">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Travel Ticket</th>
                                    <th>Station</th>
                                    <th>2nd Label</th>
                                    <th>3rd Travel Ticket</th>
                                    <th>4th Travel Ticket</th>
                                    <th>Final Label</th>
                                    <th>Test Date</th>
                                    <th>Reworked</th>
                                    <th>Rework ID</th>
                                    <th>Hostname</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in ProcessHistory)
                                {
                                    <tr>
                                        <td><strong>@row.Reference</strong></td>
                                        <td><span class="font-monospace">@row.TravelTicketLabel</span></td>
                                        <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@row.Station</MudChip></td>
                                        <td>@row.SecondLabel</td>
                                        <td>@row.ThirdTravelTicketLabel</td>
                                        <td>@row.FourthTravelTicketLabel</td>
                                        <td><span class="font-monospace">@row.FinalLabel</span></td>
                                        <td>@row.TestDate.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                        <td>
                                            @if (IsReworked(row.Reworked))
                                            {
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                                    @(row.Reworked?.ToString() ?? "YES")
                                                </MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">
                                                    @(string.IsNullOrWhiteSpace(row.Reworked?.ToString()) ? "NO" : row.Reworked?.ToString())
                                                </MudChip>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(row.ReworkId?.ToString()) ? "-" : row.ReworkId)</td>
                                        <td>@row.Hostname</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </ChildContent>
            </MudExpansionPanel>

            <!-- PANEL 2: ERROR DETAILS -->
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.ReportProblem" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Error Details</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)" Variant="Variant.Filled">
                            @Errors.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (Errors.Count == 0)
                    {
                        <div class="pa-6 text-center text-muted">
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircleOutline" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">No errors recorded!</MudText>
                            <MudText Typo="Typo.caption">This harness has passed all quality checks successfully.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0" Style="overflow-x: auto;">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Batch</th>
                                    <th>Travel Ticket</th>
                                    <th>Worker ID</th>
                                    <th>Error Type</th>
                                    <th>TMP 01</th>
                                    <th>TMP 02</th>
                                    <th>Object</th>
                                    <th>Wire1</th>
                                    <th>Wire2</th>
                                    <th>Way</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Time U</th>
                                    <th>CPV1</th>
                                    <th>CPV2</th>
                                    <th>CPV3</th>
                                    <th>CPV4</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Errors)
                                {
                                    <tr>
                                        <td><strong>@row.Reference</strong></td>
                                        <td>@row.Batch</td>
                                        <td><span class="font-monospace">@row.TravelTicketLabel</span></td>
                                        <td>@row.WorkerId</td>
                                        <td>
                                            <MudChip T="string" Color="@GetErrorColor(row.ErrorType)" Size="Size.Small" Variant="Variant.Filled">
                                                @GetErrorLabel(row.ErrorType)
                                            </MudChip>
                                        </td>
                                        <td>@row.Tmp01</td>
                                        <td>@row.Tmp02</td>
                                        <td>@row.Object</td>
                                        <td>@row.Wire1</td>
                                        <td>@row.Wire2</td>
                                        <td>@row.Way</td>
                                        <td>@row.StartDate.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                        <td>@row.EndDate.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                        <td>@row.TimeU</td>
                                        <td>@row.CPV1</td>
                                        <td>@row.CPV2</td>
                                        <td>@row.CPV3</td>
                                        <td>@row.CPV4</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
    else if (!IsLoading)
    {
        <!-- 4. EMPTY / READY STATE -->
        <MudPaper Elevation="0" Class="pa-12 d-flex flex-column align-center justify-center rounded-lg border-2 border-dashed">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.QrCodeScanner" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Class="font-weight-bold">System Ready for Scanning</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center mt-1" Style="max-width: 480px;">
                Select your site and scan a harness barcode or enter a serial number above to retrieve its process history and electrical test results.
            </MudText>
        </MudPaper>
    }
</MudStack>

@code {
    private MudTextField<string>? _searchInput;
    private List<TraceabilityRecord> ProcessHistory = new();
    private List<SolvedErrorRecord> Errors = new();
    private HarnessInformation? _harnessInfo;
    private bool IsLoading = false;
    private bool _hasSearched = false;

    private string _loadingTitle = "Initializing search...";
    private string _loadingSubtitle = "Please wait";

    private string SearchValue = string.Empty;
    private bool IsFinalLabel = true;
    private bool IncludeAllErrors = true;
    private string _selectedSite = string.Empty;

    private List<string> AvailableSites
    {
        get
        {
            if (AppState.CurrentUser is not null)
            {
                return AppState.CurrentUser.AccessibleSites ?? new List<string>();
            }
            return new List<string> { "MFZ", "K1", "K2", "PortSaid" };
        }
    }

    private string SelectedSite
    {
        get => !string.IsNullOrEmpty(_selectedSite) ? _selectedSite : (AppState.CurrentUser?.SelectedSite ?? AvailableSites.FirstOrDefault() ?? "MFZ");
        set
        {
            if (_selectedSite == value) return;
            _selectedSite = value;
            AppState.SetSelectedSite(value);
            Snackbar.Add($"Selected site: {value}", Severity.Info);
        }
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
        SyncSiteFromState();
    }

    private void HandleStateChanged()
    {
        SyncSiteFromState();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSiteFromState()
    {
        if (AppState.CurrentUser is not null && !string.IsNullOrWhiteSpace(AppState.CurrentUser.SelectedSite))
        {
            _selectedSite = AppState.CurrentUser.SelectedSite;
        }
        else
        {
            _selectedSite = AvailableSites.FirstOrDefault() ?? string.Empty;
            if (AppState.CurrentUser is not null && !string.IsNullOrEmpty(_selectedSite))
            {
                AppState.SetSelectedSite(_selectedSite);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _searchInput != null)
        {
            await _searchInput.FocusAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchValue) && !IsLoading)
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchValue)) return;
        if (AppState.CurrentUser is not null && AvailableSites.Count == 0)
        {
            Snackbar.Add("You do not have access to any site.", Severity.Error);
            return;
        }

        var trimmedInput = SearchValue.Trim();
        var labelType = IsFinalLabel ? "Harness Final Label" : "Travel Ticket";

        ProcessHistory.Clear();
        Errors.Clear();
        _harnessInfo = null;
        _hasSearched = false;
        IsLoading = true;
        _loadingTitle = $"Checking {labelType}...";
        _loadingSubtitle = $"Validating {trimmedInput} on site {SelectedSite}";
        await InvokeAsync(StateHasChanged);

        using var cts = new CancellationTokenSource();
        var progressTask = UpdateLoadingStepsAsync(labelType, trimmedInput, cts.Token);

        try
        {
            var request = new TraceabilitySearchRequest
            {
                SearchValue = trimmedInput,
                IsFinalLabel = IsFinalLabel,
                IncludeAllErrors = IncludeAllErrors,
                Site = SelectedSite
            };

            var result = await TraceabilityService.SearchAsync(request);
            await cts.CancelAsync();

            ProcessHistory = result.ProcessHistory ?? new();
            Errors = result.Errors ?? new();
            _harnessInfo = result.HarnessInformation;
            _hasSearched = true;

            if (Errors.Count > 0)
            {
                Snackbar.Add($"{Errors.Count} defect(s) detected on this harness!", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Harness conformant ({ProcessHistory.Count} process steps found)", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            await cts.CancelAsync();
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateLoadingStepsAsync(string labelType, string value, CancellationToken token)
    {
        try
        {
            await Task.Delay(700, token);
            _loadingTitle = "Collecting Process History...";
            _loadingSubtitle = $"Retrieving station records for {labelType} ({value})";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(900, token);
            _loadingTitle = "Collecting Error & Test Details...";
            _loadingSubtitle = IncludeAllErrors
                ? "Checking electrical test window & defects..."
                : "Checking all recorded defects...";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(900, token);
            _loadingTitle = "Finalizing Traceability Summary...";
            _loadingSubtitle = "Preparing process, family, and error details";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void ClearSearch()
    {
        SearchValue = string.Empty;
        ProcessHistory.Clear();
        Errors.Clear();
        _harnessInfo = null;
        _hasSearched = false;
        _searchInput?.FocusAsync();
    }

    private void ExportPdf()
    {
        Snackbar.Add("Generating PDF report...", Severity.Info);
    }

    private static bool IsReworked(object? val)
    {
        if (val is null) return false;
        if (val is bool b) return b;
        var s = val.ToString()?.Trim().ToUpperInvariant();
        return s == "Y" || s == "YES" || s == "TRUE" || s == "1" || s == "OUI";
    }

    private static Color GetErrorColor(int errorType) => errorType switch
    {
        0 or 2 or 4 or 6 or 9 or 11 => Color.Error,
        1 or 3 or 5 or 7 or 8 => Color.Warning,
        10 => Color.Info,
        _ => Color.Default
    };

    private static string GetErrorHexColor(int errorType) => errorType switch
    {
        0 or 2 or 4 or 6 or 9 or 11 => "#EF4444",
        1 or 3 or 5 or 7 or 8 => "#F59E0B",
        10 => "#3B82F6",
        _ => "#64748B"
    };

    private static string GetErrorLabel(int errorType) => errorType switch
    {
        0 => "Missing Detection (0)",
        1 => "Extra Detection (1)",
        2 => "Missing Connector (2)",
        3 => "Extra Connector (3)",
        4 => "Short Through Diode (4)",
        5 => "Open In Diode (5)",
        6 => "Diode Inverted (6)",
        7 => "Inversion (7)",
        8 => "Possible Inversion (8)",
        9 => "Short-circuit (9)",
        10 => "No Continuity (10)",
        11 => "Bad End (11)",
        _ => $"Type {errorType}"
    };

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
    }
}
