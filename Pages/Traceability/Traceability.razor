 
@page "/"
@implements IDisposable

@using HT_Web.Services.State
@using HT_Web.Models.Traceability
@using HT_Web.Services.Traceability
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inject ITraceabilityService TraceabilityService
@inject ApplicationState AppState
@inject ISnackbar Snackbar
@inject VisionReportService VisionReportService
@inject IJSRuntime JS

<PageTitle>SEWS-E Harness Traceability System</PageTitle>

<style>
    .compact-grid .mud-table-cell {
        padding: 5px 6px !important;
        font-size: 0.76rem !important;
        line-height: 1.25 !important;
        white-space: nowrap;
    }

    .compact-grid .mud-table-head .mud-table-row {
        background: linear-gradient(180deg, rgba(10, 37, 64, 0.06) 0%, rgba(10, 37, 64, 0.02) 100%);
        border-bottom: 2px solid var(--mud-palette-primary);
    }

    .compact-grid .mud-table-head .mud-table-cell {
        padding: 7px 6px !important;
        vertical-align: top !important;
    }

    .compact-grid .mud-table-head .column-header {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 2px;
    }

        .compact-grid .mud-table-head .column-header .mud-table-sort-label {
            font-size: 0.70rem !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: var(--mud-palette-text-primary);
            white-space: nowrap;
        }

        .compact-grid .mud-table-head .column-header .column-options {
            margin-left: 0 !important;
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: center !important;
            gap: 2px;
        }

            .compact-grid .mud-table-head .column-header .column-options > * {
                display: inline-flex !important;
                width: auto !important;
            }

    .compact-grid .mud-table-head .mud-icon-button {
        padding: 2px !important;
    }

    .compact-grid .mud-table-head .mud-svg-icon {
        font-size: 0.92rem !important;
    }

    .glass-loader {
        background: rgba(15, 23, 42, 0.88) !important;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(56, 189, 248, 0.25);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        color: #F8FAFC !important;
    }

    .loader-step {
        transition: all 0.25s ease;
    }
</style>



<!-- Modern 2026 Step-Tracker Loading Overlay -->
<MudOverlay Visible="@IsLoading" DarkBackground="true" Absolute="false" ZIndex="9999"
            Style="backdrop-filter: blur(6px);">
    <MudPaper Elevation="0" Class="pa-7 rounded-xl glass-loader" Style="min-width: 380px; max-width: 460px;">
        <div class="d-flex align-center gap-4 mb-5">
            <div class="d-flex align-center justify-center rounded-lg"
                 style="width: 52px; height: 52px; background: linear-gradient(135deg, #0066CC, #38BDF8);">
                <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Size="Size.Small" Style="color: white;" />
            </div>
            <div>
                <MudText Typo="Typo.overline" Style="color: #38BDF8; letter-spacing: 0.08em;">
                    SEWS MES TRACEABILITY
                </MudText>
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #FFFFFF; line-height: 1.2;">
                    @_loadingTitle
                </MudText>
                <MudText Typo="Typo.caption" Style="color: #94A3B8;">
                    @_loadingSubtitle
                </MudText>
            </div>
        </div>

        <MudStack Spacing="2" Class="mb-4">
            <div class="d-flex align-center gap-2 loader-step">
                @if (_loadingStep > 1)
                {
                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Size="Size.Small" Style="color: #34D399;" />
                }
                else
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 18px; height: 18px; color: #38BDF8;" />
                }
                <MudText Typo="Typo.body2" Style="@($"color: {(_loadingStep >= 1 ? "#F8FAFC" : "#64748B")};")">
                    Validating @(IsFinalLabel ? "Harness Final Label" : "Travel Ticket") on @SelectedSite
                </MudText>
            </div>

            <div class="d-flex align-center gap-2 loader-step">
                @if (_loadingStep > 2)
                {
                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Size="Size.Small" Style="color: #34D399;" />
                }
                else if (_loadingStep == 2)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 18px; height: 18px; color: #38BDF8;" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Rounded.RadioButtonUnchecked" Size="Size.Small" Style="color: #475569;" />
                }
                <MudText Typo="Typo.body2" Style="@($"color: {(_loadingStep >= 2 ? "#F8FAFC" : "#64748B")};")">
                    Collecting station & process history
                </MudText>
            </div>

            <div class="d-flex align-center gap-2 loader-step">
                @if (_loadingStep > 3)
                {
                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Size="Size.Small" Style="color: #34D399;" />
                }
                else if (_loadingStep == 3)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 18px; height: 18px; color: #38BDF8;" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Rounded.RadioButtonUnchecked" Size="Size.Small" Style="color: #475569;" />
                }
                <MudText Typo="Typo.body2" Style="@($"color: {(_loadingStep >= 3 ? "#F8FAFC" : "#64748B")};")">
                    Collecting electrical test & defect records
                </MudText>
            </div>
        </MudStack>

        <MudProgressLinear Color="Color.Info" Value="@(_loadingStep * 33)" Rounded="true" Size="Size.Small" />
    </MudPaper>
</MudOverlay>

<MudStack Spacing="4">
    @if (AppState.CurrentUser is not null && AvailableSites.Count == 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Elevation="1" Class="rounded-xl">
            <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        Access Denied: No Authorized Sites
                    </MudText>
                    <MudText Typo="Typo.body2">
                        User <strong>@AppState.CurrentUser.DisplayName</strong> does not exist or does not have access to any site.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Rounded.Email"
                           Href="mailto:SEWS-ECentralElectricalTestEngineers@sgcci.onmicrosoft.com?subject=Harness%20Traceability%20Software">
                    Contact Support
                </MudButton>
            </div>
        </MudAlert>
    }

    <!-- 1. SEARCH & SCAN CARD -->
    <MudCard Elevation="2" Class="rounded-xl" Style="border: 1px solid var(--mud-palette-divider);">
        <MudCardHeader Class="pb-1">
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                    <MudIcon Icon="@Icons.Material.Rounded.QrCodeScanner" />
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Harness Scan & Search</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    User: @(AppState.CurrentUser?.DisplayName ?? "User")
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="pt-2 pb-3">
            <MudGrid Spacing="2" AlignItems="Center">
                <!-- Compact Site Selector -->
                <MudItem xs="12" sm="3" md="2">
                    <MudSelect T="string"
                               @bind-Value="SelectedSite"
                               Label="Site"
                               Placeholder="Select Site..."
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Rounded.LocationOn"
                               Disabled="@(AvailableSites.Count == 0)">
                        @foreach (var site in AvailableSites)
                        {
                            <MudSelectItem T="string" Value="@site">@site</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Serial Number Barcode Input -->
                <MudItem xs="12" sm="9" md="6">
                    <MudTextField T="string"
                                  @bind-Value="SearchValue"
                                  @ref="_searchInput"
                                  Label="@(IsFinalLabel ? "Harness Final Label" : "Travel Ticket")"
                                  Placeholder="@(IsFinalLabel ? "Scan or enter Harness Label..." : "Scan or enter Travel Ticket...")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.QrCodeScanner"
                                  AdornmentColor="Color.Primary"
                                  Immediate="true"
                                  OnKeyDown="HandleKeyDown"
                                  Class="font-weight-bold text-uppercase" />
                </MudItem>

                <!-- Aligned Radio & Filter Controls -->
                <MudItem xs="12" md="4" Class="d-flex flex-column justify-center pl-md-3">
                    <MudRadioGroup T="bool" @bind-Value="IsFinalLabel" Class="d-flex align-center gap-3 ma-0 pa-0">
                        <MudRadio T="bool" Value="@true" Color="Color.Primary" Dense="true" Size="Size.Small">Final Label</MudRadio>
                        <MudRadio T="bool" Value="@false" Color="Color.Secondary" Dense="true" Size="Size.Small">Travel Ticket</MudRadio>
                    </MudRadioGroup>
                    <MudCheckBox T="bool"
                                 @bind-Value="IncludeAllErrors"
                                 Label="Electrical Test Process Only"
                                 Color="Color.Primary"
                                 Dense="true"
                                 Size="Size.Small"
                                 Class="mt-1" />
                </MudItem>
            </MudGrid>
        </MudCardContent>

        <MudCardActions Class="px-4 pb-4 pt-1 d-flex justify-space-between align-center">
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.Search"
                           OnClick="Search"
                           Disabled="@(string.IsNullOrWhiteSpace(SearchValue) || IsLoading || (AppState.CurrentUser is not null && AvailableSites.Count == 0))">
                    Search
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Rounded.Clear"
                           OnClick="ClearSearch"
                           Disabled="@(string.IsNullOrWhiteSpace(SearchValue) && ProcessHistory.Count == 0)">
                    Clear
                </MudButton>
            </div>

            @if (_hasSearched && ProcessHistory.Count > 0)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Rounded.PictureAsPdf"
                           OnClick="ExportPdf">
                    Export PDF
                </MudButton>
            }
        </MudCardActions>
    </MudCard>

    <!-- 2. RESULTS SECTION -->
    @if (!IsLoading && _hasSearched)
    {
        <!-- Verdict Banner -->
        <MudAlert Severity="@(_isLoadingErrors ? Severity.Info : (Errors.Count == 0 ? Severity.Success : Severity.Error))"
                  Variant="Variant.Filled"
                  Elevation="1"
                  Class="rounded-xl py-2">
            <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@(Errors.Count == 0 ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Warning)" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                            @(_isLoadingErrors ? "STATUS: CHECKING DEFECTS IN BACKGROUND..." : (Errors.Count == 0 ? "STATUS: CONFORMANT (PASS)" : $"STATUS: DEFECTS DETECTED ({Errors.Count} ERROR(S))"))
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @(_isLoadingErrors ? "Process history is ready below. Querying electrical test defects..." : (Errors.Count == 0 ? "No active defects recorded for this harness." : "Defect detected during testing process."))
                        </MudText>
                    </div>
                </div>
                @if (_harnessInfo is not null)
                {
                    <div class="d-flex flex-wrap gap-3">
                        <MudText Typo="Typo.caption" Class="text-white">
                            <strong>Customer:</strong> @_harnessInfo.Customer |
                            <strong>Project:</strong> @_harnessInfo.Project |
                            <strong>Family:</strong> @_harnessInfo.Family |
                            <strong>Line:</strong> @_harnessInfo.Line
                        </MudText>
                    </div>
                }
            </div>
        </MudAlert>

        <!-- Modern 2026 Inspection Summary Cards -->
        <div>
            <MudText Typo="Typo.overline" Class="font-weight-bold mb-2 d-block" Color="Color.Secondary">
                Inspection Summary & Defects Breakdown
            </MudText>
            <MudGrid Spacing="3">
                <!-- Total Process Steps Card -->
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="0" Class="pa-4"
                              Style="border-radius: 14px; border: 1px solid var(--mud-palette-divider); background: linear-gradient(135deg, rgba(10,37,64,0.04) 0%, var(--mud-palette-surface) 100%);">
                        <div class="d-flex justify-space-between align-start">
                            <div>
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">Process Steps</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2">@ProcessHistory.Count</MudText>
                            </div>
                            <MudAvatar Size="Size.Medium" Rounded="true" Style="background-color: rgba(0,102,204,0.12); color: var(--mud-palette-secondary);">
                                <MudIcon Icon="@Icons.Material.Rounded.AccountTree" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">Stations recorded</MudText>
                    </MudPaper>
                </MudItem>

                <!-- Total Errors Card -->
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="0" Class="pa-4"
                              Style="@($"border-radius: 14px; border: 1px solid {(Errors.Count > 0 ? "rgba(239,68,68,0.35)" : "rgba(16,185,129,0.35)")}; background: linear-gradient(135deg, {(Errors.Count > 0 ? "rgba(239,68,68,0.06)" : "rgba(16,185,129,0.06)")} 0%, var(--mud-palette-surface) 100%);")">
                        <div class="d-flex justify-space-between align-start">
                            <div>
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">Total Errors</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-2" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)">
                                    @Errors.Count
                                </MudText>
                            </div>
                            <MudAvatar Size="Size.Medium" Rounded="true"
                                       Style="@($"background-color: {(Errors.Count > 0 ? "rgba(239,68,68,0.14)" : "rgba(16,185,129,0.14)")}; color: {(Errors.Count > 0 ? "#EF4444" : "#10B981")};")">
                                <MudIcon Icon="@(Errors.Count > 0 ? Icons.Material.Rounded.ErrorOutline : Icons.Material.Rounded.Verified)" />
                            </MudAvatar>
                        </div>
                        <MudText Typo="Typo.caption" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)" Class="mt-2 d-block font-weight-medium">
                            @(Errors.Count > 0 ? "Defects detected" : "Clean inspection")
                        </MudText>
                    </MudPaper>
                </MudItem>

                <!-- Dynamic Card per Error Type -->
                @if (Errors.Count > 0)
                {
                    @foreach (var group in Errors.GroupBy(e => e.ErrorType).OrderBy(g => g.Key))
                    {
                        var hex = GetErrorHexColor(group.Key);
                        <MudItem xs="6" sm="4" md="3">
                            <MudPaper Elevation="0" Class="pa-4"
                                      Style="@($"border-radius: 14px; border: 1px solid var(--mud-palette-divider); background: linear-gradient(135deg, {hex}12 0%, var(--mud-palette-surface) 100%);")">
                                <div class="d-flex justify-space-between align-start">
                                    <div style="min-width: 0;">
                                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">Type @group.Key</MudText>
                                        <MudText Typo="Typo.h4" Class="font-weight-bold mt-2" Style="@($"color: {hex};")">
                                            @group.Count()
                                        </MudText>
                                    </div>
                                    <MudAvatar Size="Size.Medium" Rounded="true" Style="@($"background-color: {hex}20; color: {hex};")">
                                        <MudIcon Icon="@Icons.Material.Rounded.BugReport" />
                                    </MudAvatar>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block text-truncate">
                                    @GetErrorLabel(group.Key)
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    }
                }
            </MudGrid>
        </div>

        <!-- 3. EXPANDABLE INTERACTIVE DATA GRIDS -->
        <MudExpansionPanels MultiExpansion="true" Elevation="1" Class="rounded-xl mt-2">
            <!-- PANEL 1: PROCESS HISTORY -->
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.History" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Process History</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@ProcessHistory.Count</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (ProcessHistory.Count == 0)
                    {
                        <div class="pa-6 text-center text-muted">
                            <MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body2">No process history found for this reference.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudDataGrid T="TraceabilityRecord"
                                     Items="@ProcessHistory"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     Filterable="true"
                                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                                     Groupable="true"
                                     SortMode="SortMode.Multiple"
                                     QuickFilter="@_processQuickFilter"
                                     HorizontalScrollbar="true"
                                     Class="compact-grid"
                                     Elevation="0">
                            <ToolBarContent>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Use column menus to filter, sort, or group
                                </MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_processSearchString"
                                              Placeholder="Search process history..."
                                              Adornment="Adornment.Start"
                                              Immediate="true"
                                              AdornmentIcon="@Icons.Material.Rounded.Search"
                                              IconSize="Size.Small"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Outlined"
                                              Style="max-width: 280px;" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.Reference" Title="Reference" />
                                <PropertyColumn Property="x => x.TravelTicketLabel" Title="Travel Ticket" />
                                <PropertyColumn Property="x => x.Station" Title="Station">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Item.Station</MudChip>
                                    </CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.SecondLabel" Title="2nd Label" />
                                @if (ShowThirdTravelTicket)
                                {
                                    <PropertyColumn Property="x => x.ThirdTravelTicketLabel" Title="3rd Travel Ticket" />
                                }
                                @if (ShowFourthTravelTicket)
                                {
                                    <PropertyColumn Property="x => x.FourthTravelTicketLabel" Title="4th Travel Ticket" />
                                }
                                <PropertyColumn Property="x => x.FinalLabel" Title="Final Label" />
                                <PropertyColumn Property="x => x.TestDate" Title="Test Date" Format="dd-MM-yyyy HH:mm:ss" />
                                <PropertyColumn Property="x => x.Reworked" Title="Reworked">
                                    <CellTemplate>
                                        @if (IsReworked(context.Item.Reworked))
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                                @(context.Item.Reworked ?? "YES")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">
                                                @(string.IsNullOrWhiteSpace(context.Item.Reworked) ? "NO" : context.Item.Reworked)
                                            </MudChip>
                                        }
                                    </CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.ReworkId" Title="Rework ID" />
                                <PropertyColumn Property="x => x.Hostname" Title="Hostname" />
                                <TemplateColumn T="TraceabilityRecord" Title="Vision Report" Sortable="false" Filterable="false">
                                    <CellTemplate>
                                        @if (IsVisionStation(context.Item.Station))
                                        {
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Rounded.PictureAsPdf"
                                                       OnClick="@(() => OpenVisionReportAsync(context.Item))">
                                                Open Report
                                            </MudButton>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="TraceabilityRecord" />
                            </PagerContent>
                        </MudDataGrid>
                    }
                </ChildContent>
            </MudExpansionPanel>

            <!-- PANEL 2: ERROR DETAILS -->
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.ReportProblem" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Error Details</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(Errors.Count > 0 ? Color.Error : Color.Success)" Variant="Variant.Filled">
                            @Errors.Count
                        </MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (_isLoadingErrors)
                    {
                        <div class="pa-6 text-center">
                            <MudProgressCircular Color="Color.Info" Indeterminate="true" Size="Size.Small" Class="mb-2" />
                            <MudText Typo="Typo.body2" Class="font-weight-bold">Searching electrical test & defect records...</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">You can already inspect Process History above while errors load.</MudText>
                        </div>
                    }
                    else if (Errors.Count == 0)
                    {
                        <div class="pa-6 text-center text-muted">
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircleOutline" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">No errors recorded!</MudText>
                            <MudText Typo="Typo.caption">This harness has passed all quality checks successfully.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudDataGrid T="SolvedErrorRecord"
                                     Items="@Errors"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     Filterable="true"
                                     FilterMode="DataGridFilterMode.ColumnFilterMenu"
                                     Groupable="true"
                                     SortMode="SortMode.Multiple"
                                     QuickFilter="@_errorQuickFilter"
                                     HorizontalScrollbar="true"
                                     Class="compact-grid"
                                     Elevation="0">
                            <ToolBarContent>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Use column menus to filter, sort, or group
                                </MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="_errorSearchString"
                                              Placeholder="Search error details..."
                                              Adornment="Adornment.Start"
                                              Immediate="true"
                                              AdornmentIcon="@Icons.Material.Rounded.Search"
                                              IconSize="Size.Small"
                                              Margin="Margin.Dense"
                                              Variant="Variant.Outlined"
                                              Style="max-width: 280px;" />
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.Reference" Title="Reference" />
                                <PropertyColumn Property="x => x.Batch" Title="Batch" />
                                <PropertyColumn Property="x => x.TravelTicketLabel" Title="Travel Ticket" />
                                <PropertyColumn Property="x => x.WorkerId" Title="Worker ID" />
                                <PropertyColumn Property="x => x.ErrorType" Title="Error Type">
                                    <CellTemplate>
                                        <MudChip T="string" Color="@GetErrorColor(context.Item.ErrorType)" Size="Size.Small" Variant="Variant.Filled">
                                            @GetErrorLabel(context.Item.ErrorType)
                                        </MudChip>
                                    </CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Tmp01" Title="TMP 01" />
                                <PropertyColumn Property="x => x.Tmp02" Title="TMP 02" />
                                <PropertyColumn Property="x => x.Object" Title="Object" />
                                <PropertyColumn Property="x => x.Wire1" Title="Wire 1" />
                                <PropertyColumn Property="x => x.Wire2" Title="Wire 2" />
                                <PropertyColumn Property="x => x.Way" Title="Way" />
                                <PropertyColumn Property="x => x.StartDate" Title="Start Date" Format="dd-MM-yyyy HH:mm:ss" />
                                <PropertyColumn Property="x => x.EndDate" Title="End Date" Format="dd-MM-yyyy HH:mm:ss" />
                                <PropertyColumn Property="x => x.TimeU" Title="Time U" />
                                <PropertyColumn Property="x => x.CPV1" Title="CPV1" />
                                <PropertyColumn Property="x => x.CPV2" Title="CPV2" />
                                <PropertyColumn Property="x => x.CPV3" Title="CPV3" />
                                <PropertyColumn Property="x => x.CPV4" Title="CPV4" />
                                <PropertyColumn Property="x => x.Hostname" Title="Hostname" />
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="SolvedErrorRecord" />
                            </PagerContent>
                        </MudDataGrid>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
    else if (!IsLoading)
    {
        <!-- 4. EMPTY / READY STATE -->
        <MudPaper Elevation="0" Class="pa-12 d-flex flex-column align-center justify-center rounded-xl border-2 border-dashed">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.QrCodeScanner" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h6" Class="font-weight-bold">System Ready for Scanning</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center mt-1" Style="max-width: 480px;">
                Select your site and scan a harness barcode or enter a serial number above to retrieve its process history and electrical test results.
            </MudText>
        </MudPaper>
    }
</MudStack>

@code {
    private MudTextField<string>? _searchInput;
    private List<TraceabilityRecord> ProcessHistory = new();
    private List<SolvedErrorRecord> Errors = new();
    private HarnessInformation? _harnessInfo;
    private bool IsLoading = false;
    private bool _isLoadingErrors = false;
    private bool _hasSearched = false;

    private int _loadingStep = 1;
    private string _loadingTitle = "Checking Harness...";
    private string _loadingSubtitle = "Please wait";

    private string SearchValue = string.Empty;
    private bool IsFinalLabel = true;
    private bool IncludeAllErrors = true;
    private string _selectedSite = string.Empty;

    private string _processSearchString = string.Empty;
    private string _errorSearchString = string.Empty;

    private bool ShowThirdTravelTicket => ProcessHistory.Any(x => !string.IsNullOrWhiteSpace(x.ThirdTravelTicketLabel));
    private bool ShowFourthTravelTicket => ProcessHistory.Any(x => !string.IsNullOrWhiteSpace(x.FourthTravelTicketLabel));

    private Func<TraceabilityRecord, bool> _processQuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_processSearchString))
            return true;

        return (x.Reference?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.TravelTicketLabel?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Station?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.FinalLabel?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Hostname?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ReworkId?.Contains(_processSearchString, StringComparison.OrdinalIgnoreCase) ?? false);
    };

    private Func<SolvedErrorRecord, bool> _errorQuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_errorSearchString))
            return true;

        return (x.Reference?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Batch?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.TravelTicketLabel?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.WorkerId?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || GetErrorLabel(x.ErrorType).Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase)
            || (x.Object?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Wire1?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Wire2?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Hostname?.Contains(_errorSearchString, StringComparison.OrdinalIgnoreCase) ?? false);
    };

    private List<string> AvailableSites
    {
        get
        {
            if (AppState.CurrentUser is not null)
            {
                return AppState.CurrentUser.AccessibleSites ?? new List<string>();
            }
            return new List<string> { "MFZ", "K1", "K2", "PortSaid" };
        }
    }

    private string SelectedSite
    {
        get => !string.IsNullOrEmpty(_selectedSite) ? _selectedSite : (AppState.CurrentUser?.SelectedSite ?? AvailableSites.FirstOrDefault() ?? "MFZ");
        set
        {
            if (_selectedSite == value) return;
            _selectedSite = value;
            AppState.SetSelectedSite(value);
            Snackbar.Add($"Selected site: {value}", Severity.Info);
        }
    }

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
        SyncSiteFromState();
        // Restore previous tab-session search results if any
        var s = AppState.Traceability;
        SearchValue = s.SearchValue;
        IsFinalLabel = s.IsFinalLabel;
        IncludeAllErrors = s.IncludeAllErrors;
        _hasSearched = s.HasSearched;
        ProcessHistory = s.ProcessHistory;
        Errors = s.Errors;
        _harnessInfo = s.HarnessInfo;
    }

    private void HandleStateChanged()
    {
        SyncSiteFromState();
        // Restore previous tab-session search results if any
        var s = AppState.Traceability;
        SearchValue = s.SearchValue;
        IsFinalLabel = s.IsFinalLabel;
        IncludeAllErrors = s.IncludeAllErrors;
        _hasSearched = s.HasSearched;
        ProcessHistory = s.ProcessHistory;
        Errors = s.Errors;
        _harnessInfo = s.HarnessInfo;
        InvokeAsync(StateHasChanged);
    }

    private void SyncSiteFromState()
    {
        if (AppState.CurrentUser is not null && !string.IsNullOrWhiteSpace(AppState.CurrentUser.SelectedSite))
        {
            _selectedSite = AppState.CurrentUser.SelectedSite;
        }
        else
        {
            _selectedSite = AvailableSites.FirstOrDefault() ?? string.Empty;
            if (AppState.CurrentUser is not null && !string.IsNullOrEmpty(_selectedSite))
            {
                AppState.SetSelectedSite(_selectedSite);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _searchInput != null)
        {
            await _searchInput.FocusAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SearchValue) && !IsLoading)
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchValue)) return;
        if (AppState.CurrentUser is not null && AvailableSites.Count == 0)
        {
            Snackbar.Add("You do not have access to any site.", Severity.Error);
            return;
        }

        var trimmedInput = SearchValue.Trim();
        var labelType = IsFinalLabel ? "Harness Final Label" : "Travel Ticket";

        ProcessHistory.Clear();
        Errors.Clear();
        _harnessInfo = null;
        _processSearchString = string.Empty;
        _errorSearchString = string.Empty;
        _hasSearched = false;
        _loadingStep = 1;
        IsLoading = true;
        _loadingTitle = $"Checking {labelType}...";
        _loadingSubtitle = $"{trimmedInput} � Site {SelectedSite}";
        await InvokeAsync(StateHasChanged);

        using var cts = new CancellationTokenSource();
        var progressTask = UpdateLoadingStepsAsync(labelType, trimmedInput, cts.Token);

        try
        {
            var request = new TraceabilitySearchRequest
            {
                SearchValue = trimmedInput,
                IsFinalLabel = IsFinalLabel,
                IncludeAllErrors = IncludeAllErrors,
                Site = SelectedSite,
                Username = AppState.CurrentUser?.DisplayName ?? Environment.UserName
            };

            var sw = System.Diagnostics.Stopwatch.StartNew();
            var historyResult = await TraceabilityService.SearchProcessHistoryAsync(request);
            await cts.CancelAsync();

            ProcessHistory = historyResult.ProcessHistory ?? new();
            _harnessInfo = historyResult.HarnessInformation;
            _hasSearched = true;
            IsLoading = false;
            _isLoadingErrors = true;
            SaveTraceabilityState();
            await InvokeAsync(StateHasChanged);

            Snackbar.Add($"Process history loaded in {sw.Elapsed.TotalSeconds:0.1}s — checking defects in background...", Severity.Info);

            Errors = await TraceabilityService.SearchErrorsAsync(request, ProcessHistory, historyResult.ErrorSearchKeys);
            _isLoadingErrors = false;
            SaveTraceabilityState();

            if (Errors.Count > 0)
            {
                Snackbar.Add($"{Errors.Count} defect(s) detected ({sw.Elapsed.TotalSeconds:0.1}s total)", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Harness conformant ({ProcessHistory.Count} steps, {sw.Elapsed.TotalSeconds:0.1}s total)", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            await cts.CancelAsync();
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            _isLoadingErrors = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateLoadingStepsAsync(string labelType, string value, CancellationToken token)
    {
        try
        {
            await Task.Delay(600, token);
            _loadingStep = 2;
            _loadingTitle = "Collecting Process History...";
            _loadingSubtitle = $"Querying {labelType}: {value}";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(800, token);
            _loadingStep = 3;
            _loadingTitle = "Collecting Error Details...";
            _loadingSubtitle = IncludeAllErrors
                ? "Checking electrical test window & defects"
                : "Checking all recorded defects";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void ClearSearch()
    {
        SearchValue = string.Empty;
        ProcessHistory.Clear();
        Errors.Clear();
        _harnessInfo = null;
        _processSearchString = string.Empty;
        _errorSearchString = string.Empty;
        _hasSearched = false;
        SaveTraceabilityState();
        _searchInput?.FocusAsync();
    }

    private void ExportPdf()
    {
        Snackbar.Add("Generating PDF report...", Severity.Info);
    }

    private static bool IsReworked(object? val)
    {
        if (val is null) return false;
        if (val is bool b) return b;
        var s = val.ToString()?.Trim().ToUpperInvariant();
        return s == "Y" || s == "YES" || s == "TRUE" || s == "1" || s == "OUI";
    }

    private static Color GetErrorColor(int errorType) => errorType switch
    {
        0 or 2 or 4 or 6 or 9 or 11 => Color.Error,
        1 or 3 or 5 or 7 or 8 => Color.Warning,
        10 => Color.Info,
        _ => Color.Default
    };

    private static string GetErrorHexColor(int errorType) => errorType switch
    {
        0 or 2 or 4 or 6 or 9 or 11 => "#EF4444",
        1 or 3 or 5 or 7 or 8 => "#F59E0B",
        10 => "#3B82F6",
        _ => "#64748B"
    };

    private static string GetErrorLabel(int errorType) => errorType switch
    {
        0 => "Missing Detection (0)",
        1 => "Extra Detection (1)",
        2 => "Missing Connector (2)",
        3 => "Extra Connector (3)",
        4 => "Short Through Diode (4)",
        5 => "Open In Diode (5)",
        6 => "Diode Inverted (6)",
        7 => "Inversion (7)",
        8 => "Possible Inversion (8)",
        9 => "Short-circuit (9)",
        10 => "No Continuity (10)",
        11 => "Bad End (11)",
        _ => $"Type {errorType}"
    };

    private static bool IsVisionStation(string? station)
    {
        return !string.IsNullOrWhiteSpace(station)
            && station.Contains("Vision", StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenVisionReportAsync(TraceabilityRecord record)
    {
        var (filePath, errorMessage) = VisionReportService.FindVisionReport(record.Hostname, record.TestDate);
        if (string.IsNullOrWhiteSpace(filePath))
        {
            Snackbar.Add(errorMessage ?? "The PDF report does not exist.", Severity.Warning);
            return;
        }

        var url = $"/api/vision-report?hostname={Uri.EscapeDataString(record.Hostname ?? string.Empty)}&testDate={Uri.EscapeDataString(record.TestDate.ToString("O"))}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void SaveTraceabilityState()
    {
        var s = AppState.Traceability;
        s.SearchValue = SearchValue;
        s.IsFinalLabel = IsFinalLabel;
        s.IncludeAllErrors = IncludeAllErrors;
        s.HasSearched = _hasSearched;
        s.ProcessHistory = ProcessHistory;
        s.Errors = Errors;
        s.HarnessInfo = _harnessInfo;
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
    }
}
