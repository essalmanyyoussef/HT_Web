@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_dark" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _open = !_open)" />
        <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
        <MudText Typo="Typo.h6"><b>ET Training</b></MudText>
        <MudSpacer />
        <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@(() => _dark = !_dark)" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_open" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>Training Manager</b></MudText>
        </MudDrawerHeader>
        <MudNavMenu Color="Color.Primary" Rounded="true" Class="pa-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavGroup Title="Setup" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                <MudNavLink Href="/sites" Icon="@Icons.Material.Filled.LocationCity">Sites</MudNavLink>
                <MudNavLink Href="/functions" Icon="@Icons.Material.Filled.WorkOutline">Functions</MudNavLink>
                <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/courses" Icon="@Icons.Material.Filled.MenuBook">Courses</MudNavLink>
            <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.People">Employees</MudNavLink>
            <MudNavLink Href="/assign-courses" Icon="@Icons.Material.Filled.AssignmentInd">Assign courses</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">@Body</MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _open = true;
    private bool _dark;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            Secondary = "#0891B2",
            Tertiary = "#0D9488",
            AppbarBackground = "#4F46E5",
            Background = "#F5F6FA",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            Success = "#16A34A"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8",
            Secondary = "#22D3EE",
            AppbarBackground = "#1E1B4B",
            Background = "#111827",
            Surface = "#1F2937",
            DrawerBackground = "#1F2937"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };
}
