@inherits LayoutComponentBase
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _open = !_open)" />
        <MudText Typo="Typo.h6">ET training</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_open" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="/sites">Sites</MudNavLink>
            <MudNavLink Href="/functions">Functions</MudNavLink>
            <MudNavLink Href="/categories">Categories</MudNavLink>
            <MudNavLink Href="/courses">Courses</MudNavLink>
            <MudNavLink Href="/employees">Employees</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="mt-4">@Body</MudContainer>
    </MudMainContent>
</MudLayout>

@code { private bool _open = true; }
