@page "/employees"
@using ET_Training.Data
@using ET_Training.Models
@using ET_Training.Components.Dialogs
@inject TrainingRepository Repo
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Employees - ET Training</PageTitle>

<div class="d-flex align-center flex-wrap gap-3 mb-4">
    <div class="mr-auto d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h5"><b>Employees</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_items.Count employee(s), @_items.Count(e => e.IsActive) active</MudText>
        </div>
    </div>
    <MudTextField @bind-Value="_search" Placeholder="Search name, username, site..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:280px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Add">New employee</MudButton>
</div>

<MudPaper Elevation="3" Class="rounded-lg">
    <MudTable Items="Filtered" Hover="true" Striped="true" Dense="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>Employee</MudTh>
            <MudTh>Site</MudTh>
            <MudTh>Function</MudTh>
            <MudTh>Hired</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="width:110px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Employee">
                <div class="d-flex align-center">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mr-2">@Initials(context.Name)</MudAvatar>
                    <div>
                        <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Username@(string.IsNullOrEmpty(context.EmailAddress) ? "" : " · " + context.EmailAddress)</MudText>
                    </div>
                </div>
            </MudTd>
            <MudTd DataLabel="Site">@context.SiteName</MudTd>
            <MudTd DataLabel="Function">@context.FunctionName</MudTd>
            <MudTd DataLabel="Hired">@context.Date_emp.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">Left @(context.Date_Leave?.ToString("yyyy-MM-dd"))</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Edit(context))" /></MudTooltip>
                <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No employees found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Employee> _items = new();
    private string _search = "";
    private bool _loading = true;

    private IEnumerable<Employee> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x => x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || x.Username.Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || (x.EmailAddress ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || (x.SiteName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || (x.FunctionName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpper(),
            _ => ("" + parts[0][0] + parts[^1][0]).ToUpper()
        };
    }

    private async Task Load()
    {
        _loading = true;
        try { _items = await Repo.GetEmployees(); }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
        _loading = false;
    }

    private async Task Add() => await OpenDialog(new Employee());

    private async Task Edit(Employee x) => await OpenDialog(new Employee
    {
        ID_employe = x.ID_employe, Name = x.Name, Username = x.Username, EmailAddress = x.EmailAddress,
        Id_site = x.Id_site, Id_Function = x.Id_Function, Date_emp = x.Date_emp, Date_Leave = x.Date_Leave, IsActive = x.IsActive
    });

    private async Task OpenDialog(Employee item)
    {
        var dlg = await Dialogs.ShowAsync<EmployeeDialog>(item.ID_employe == 0 ? "New employee" : "Edit employee",
            new DialogParameters<EmployeeDialog> { { d => d.Item, item } });
        var result = await dlg.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task Delete(Employee x)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete employee", $"Delete '{x.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Repo.DeleteEmployee(x.ID_employe);
            Snackbar.Add("Deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
    }
}
