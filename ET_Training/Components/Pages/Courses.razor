@page "/courses"
@using ET_Training.Data
@using ET_Training.Models
@using ET_Training.Components.Dialogs
@inject TrainingRepository Repo
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Courses - ET Training</PageTitle>

<div class="d-flex align-center flex-wrap gap-3 mb-4">
    <div class="mr-auto d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Large" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h5"><b>Courses</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_items.Count course(s)</MudText>
        </div>
    </div>
    <MudTextField @bind-Value="_search" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">New course</MudButton>
</div>

<MudPaper Elevation="3" Class="rounded-lg">
    <MudTable Items="Filtered" Hover="true" Striped="true" Dense="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>Course</MudTh>
            <MudTh>Category</MudTh>
            <MudTh Style="width:110px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Course"><b>@context.CourseName</b></MudTd>
            <MudTd DataLabel="Category">
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">@context.CategoryName</MudChip>
            </MudTd>
            <MudTd>
                <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Edit(context))" /></MudTooltip>
                <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No courses found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Course> _items = new();
    private string _search = "";
    private bool _loading = true;

    private IEnumerable<Course> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x => x.CourseName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || (x.CategoryName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try { _items = await Repo.GetCourses(); }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
        _loading = false;
    }

    private async Task Add() => await OpenDialog(new Course());

    private async Task Edit(Course x) => await OpenDialog(new Course { ID_Course = x.ID_Course, CourseName = x.CourseName, Id_Category = x.Id_Category });

    private async Task OpenDialog(Course item)
    {
        var dlg = await Dialogs.ShowAsync<CourseDialog>(item.ID_Course == 0 ? "New course" : "Edit course",
            new DialogParameters<CourseDialog> { { d => d.Item, item } });
        var result = await dlg.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task Delete(Course x)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete course", $"Delete '{x.CourseName}'?", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Repo.DeleteCourse(x.ID_Course);
            Snackbar.Add("Deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
    }
}
