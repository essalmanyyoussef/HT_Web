@page "/categories"
@using ET_Training.Data
@using ET_Training.Models
@using ET_Training.Components.Dialogs
@inject TrainingRepository Repo
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Categories - ET Training</PageTitle>

<div class="d-flex align-center flex-wrap gap-3 mb-4">
    <div class="mr-auto d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Large" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h5"><b>Categories</b></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_items.Count category(ies)</MudText>
        </div>
    </div>
    <MudTextField @bind-Value="_search" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">New category</MudButton>
</div>

<MudPaper Elevation="3" Class="rounded-lg">
    <MudTable Items="Filtered" Hover="true" Striped="true" Dense="true" Loading="_loading" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh Style="width:110px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><b>@context.CategoryName</b></MudTd>
            <MudTd>
                <MudTooltip Text="Edit"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Edit(context))" /></MudTooltip>
                <MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No categories found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<Category> _items = new();
    private string _search = "";
    private bool _loading = true;

    private IEnumerable<Category> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x => x.CategoryName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try { _items = await Repo.GetCategories(); }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
        _loading = false;
    }

    private async Task Add() => await OpenDialog(new Category());

    private async Task Edit(Category x) => await OpenDialog(new Category { Id_Category = x.Id_Category, CategoryName = x.CategoryName });

    private async Task OpenDialog(Category item)
    {
        var dlg = await Dialogs.ShowAsync<CategoryDialog>(item.Id_Category == 0 ? "New category" : "Edit category",
            new DialogParameters<CategoryDialog> { { d => d.Item, item } });
        var result = await dlg.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task Delete(Category x)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete category", $"Delete '{x.CategoryName}'? This fails if courses are linked to it.", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        try
        {
            await Repo.DeleteCategory(x.Id_Category);
            Snackbar.Add("Deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(TrainingRepository.Explain(ex), Severity.Error); }
    }
}
