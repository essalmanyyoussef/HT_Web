@inherits LayoutComponentBase
@implements IDisposable

@using HT_Web.Theme
@using HT_Web.Services.State
@using HT_Web.Services.Authentication

@inject ApplicationState AppState
@inject IUserAccessService UserAccessService

<MudThemeProvider Theme="@SEWSTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" MaxWidth="MaxWidth.Medium" />
<MudSnackbarProvider AnchorOrigin="SnackbarOrigin.BottomRight" />

<!-- Initial Access & Site Verification Overlay -->
<MudOverlay Visible="@AppState.IsCheckingAccess" DarkBackground="true" Absolute="false" ZIndex="9999"
            Style="backdrop-filter: blur(8px);">
    <MudPaper Elevation="0" Class="pa-7 rounded-xl"
              Style="min-width: 360px; max-width: 440px; background: rgba(15, 23, 42, 0.92); border: 1px solid rgba(56, 189, 248, 0.3); color: #F8FAFC;">
        <div class="d-flex align-center gap-4 mb-4">
            <div class="d-flex align-center justify-center rounded-lg"
                 style="width: 48px; height: 48px; background: linear-gradient(135deg, #0066CC, #38BDF8);">
                <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Size="Size.Small" Style="color: white;" />
            </div>
            <div>
                <MudText Typo="Typo.overline" Style="color: #38BDF8; letter-spacing: 0.08em;">
                    SEWS MES TRACEABILITY
                </MudText>
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #FFFFFF; line-height: 1.2;">
                    Verifying User Access
                </MudText>
            </div>
        </div>
        <MudText Typo="Typo.body2" Style="color: #CBD5E1;" Class="mb-3">
            @AppState.AccessStatusMessage
        </MudText>
        <MudProgressLinear Color="Color.Info" Indeterminate="true" Rounded="true" Size="Size.Small" />
    </MudPaper>
</MudOverlay>

<MudLayout>
    <MudAppBar Elevation="1" Dense="false" Class="px-4">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       Class="mr-2" />

        <MudIcon Icon="@Icons.Material.Rounded.Hub" Size="Size.Large" Class="mr-2" />
        <div>
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="line-height: 1.1;">
                SEWS-E Harness Traceability System
            </MudText>
            <MudText Typo="Typo.caption" Style="opacity: 0.75;">
                Developed by Central Electrical Test Team
            </MudText>
        </div>

        <MudSpacer />

        @if (AppState.CurrentUser != null && !string.IsNullOrWhiteSpace(AppState.CurrentUser.SelectedSite))
        {
            <MudChip T="string"
                     Color="Color.Secondary"
                     Variant="Variant.Filled"
                     Size="Size.Small"
                     Icon="@Icons.Material.Rounded.LocationOn"
                     Class="mr-3 font-weight-bold">
                @AppState.CurrentUser.SelectedSite
            </MudChip>
        }

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme"
                       Title="Toggle light/dark theme"
                       Class="mr-2" />

        @if (AppState.CurrentUser != null)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudAvatar Color="Color.Secondary" Size="Size.Medium" Style="cursor: pointer;">
                        @(AppState.CurrentUser.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                    </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-3" style="min-width: 220px;">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            @AppState.CurrentUser.DisplayName
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Site: @(AppState.CurrentUser.SelectedSite ?? "None")
                        </MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Rounded.ManageAccounts" Href="/admin">
                        Administration
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Width="@(_isCollapsed ? "76px" : "260px")"
               Style="overflow: visible; background: transparent;">
        <NavMenu IsCollapsed="@_isCollapsed"
                 IsDarkMode="@_isDarkMode"
                 OnToggleCollapse="ToggleCollapse"
                 OnToggleDarkMode="ToggleTheme" />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4 pb-8" Style="background-color: var(--mud-palette-background); min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isCollapsed = false;
    private bool _isDarkMode = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AppState.CurrentUser == null)
        {
            AppState.SetCheckingAccess(true, "Checking Active Directory identity & authorized sites...");
            var user = await UserAccessService.GetCurrentUserAsync();
            if (user != null)
            {
                AppState.SetCurrentUser(user);
            }
            else
            {
                AppState.SetCheckingAccess(false);
            }
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleCollapse() => _isCollapsed = !_isCollapsed;
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChanged;
    }
}